        {
            "id": "565882ef-cd95-4f55-a6b4-c13ee2be9052",
            "name": "Reply To Guest",
            "type": "n8n-nodes-base.respondToWebhook",
            "position": [
                1280,
                300
            ],
            "parameters": {
                "options": {
                    "responseHeaders": {
                        "entries": [
                            {
                                "name": "Content-Type",
                                "value": "={{ $(\"Normalize Message\").item.json.channel === \"whatsapp\" ? \"text/xml\" : \"application/json\" }}"
                            }
                        ]
                    }
                },
                "respondWith": "text",
                "responseBody": "={{ $('Normalize Message').item.json.channel === 'whatsapp' ? ('<?xml version=\"1.0\" encoding=\"UTF-8\"?><Response><Message>' + ($('Gemini Concierge').item.json.candidates?.[0]?.content?.parts?.[0]?.text ?? '¡Gracias por tu mensaje! ¿En qué puedo ayudarte: habitaciones, precios, piscina, parqueo o reservas?').toString().replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</Message></Response>') : JSON.stringify({ reply: ($('Gemini Concierge').item.json.candidates?.[0]?.content?.parts?.[0]?.text ?? '¡Gracias por tu mensaje!') }) }}"
            },
            "typeVersion": 1.5
        },
