                            "value": "={{ $json.person.title }}"
                        },
                        {
                            "id": "a4",
                            "name": "email",
                            "type": "string",
                            "value": "={{ $json.person.email }}"
                        },
                        {
                            "id": "a5",
                            "name": "email_status",
                            "type": "string",
                            "value": "={{ $json.person.email_status }}"
                        },
                        {
                            "id": "a6",
                            "name": "phone",
                            "type": "string",
                            "value": "={{ $json.person.organization?.phone ?? $json.person.phone_numbers?.[0]?.raw_number }}"
                        },
                        {
                            "id": "a7",
