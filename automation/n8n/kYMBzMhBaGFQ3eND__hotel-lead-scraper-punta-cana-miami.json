                        },
                        {
                            "id": "a12",
                            "name": "num_employees",
                            "type": "number",
                            "value": "={{ $json.person.organization?.estimated_num_employees }}"
                        },
                        {
                            "id": "a13",
                            "name": "apollo_person_id",
                            "type": "string",
                            "value": "={{ $json.person.id }}"
                        },
                        {
                            "id": "a14",
                            "name": "enriched_at",
                            "type": "string",
                            "value": "={{ $now.toISO() }}"
                        }
                    ]
                },
                "includeOtherFields": false
            },
            "typeVersion": 3.4
        },
        {
            "id": "4e199dc4-e0f3-430f-88e3-2b77742087fd",
            "name": "Loop Tasks",
            "type": "n8n-nodes-base.splitInBatches",
            "position": [
                460,
                300
            ],
            "parameters": {
                "batchSize": 1
            },
            "typeVersion": 3
        },
        {
            "id": "df06936f-5864-4ff3-bfa7-ece9817af187",
            "name": "Sticky Note 69307ea2",
            "type": "n8n-nodes-base.stickyNote",
            "position": [
                1550,
                150
            ],
            "parameters": {
                "color": 4,
                "width": 300,
                "height": 200,
                "content": "## Connect your sink here\nEach item leaving \"Lead Row\" is one clean hotel decision-maker contact.\nDrop an n8n Data Table / Airtable / Supabase node between \"Lead Row\" and the loop-back to persist them, then export CSV for Joshua."
            },
            "typeVersion": 1
        },
        {
            "id": "27717ce8-b0d6-44fa-86c1-2820a07a79bb",
            "name": "Sticky Note fde48d19",
            "type": "n8n-nodes-base.stickyNote",
            "position": [
                670,
                150
            ],
            "parameters": {
                "color": 3,
                "width": 300,
                "height": 200,
                "content": "## Setup\n1. Paste your Apollo API key into BOTH HTTP nodes (X-Api-Key header).\n2. Edit pagesPerMarket in \"Build Search Tasks\" to control volume (3 pages x 100 = ~300 rows/market).\n3. To restrict strictly to hotels, add Apollo Industry = Hospitality filter in the search body using YOUR account industry tag id (do not guess it)."
            },
            "typeVersion": 1
        }
    ],
