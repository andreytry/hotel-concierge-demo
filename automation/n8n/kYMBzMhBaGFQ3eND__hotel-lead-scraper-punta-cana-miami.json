                            "type": "string",
                            "value": "={{ $json.person.city ?? $('Loop Tasks').item.json.city }}"
                        },
                        {
                            "id": "a9",
                            "name": "country",
                            "type": "string",
                            "value": "={{ $json.person.country ?? $('Loop Tasks').item.json.country }}"
                        },
                        {
                            "id": "a10",
                            "name": "company_website",
                            "type": "string",
                            "value": "={{ $json.person.organization?.website_url }}"
