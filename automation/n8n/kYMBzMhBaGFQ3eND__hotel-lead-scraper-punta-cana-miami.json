{
    "name": "Hotel Lead Scraper - Punta Cana & Miami",
    "nodes": [
        {
            "id": "96bb008e-97f7-4253-92a6-637220957f3e",
            "name": "Run Scrape",
            "type": "n8n-nodes-base.manualTrigger",
            "position": [
                0,
                300
            ],
            "parameters": {
            },
            "typeVersion": 1
        },
        {
            "id": "2d317bb0-a322-456f-8420-a75df6cba224",
            "name": "Build Search Tasks",
            "type": "n8n-nodes-base.code",
            "position": [
                220,
                300
            ],
            "parameters": {
                "jsCode": "const pagesPerMarket = 3;\nconst markets = [\n  { market: \"Punta Cana\", location: \"Punta Cana, Dominican Republic\", city: \"Punta Cana\", country: \"Dominican Republic\" },\n  { market: \"Miami\", location: \"Miami, Florida, United States\", city: \"Miami\", country: \"United States\" }\n];\nconst tasks = [];\nfor (const m of markets) {\n  for (let p = 1; p <= pagesPerMarket; p++) {\n    tasks.push({ json: { market: m.market, location: m.location, city: m.city, country: m.country, page: p } });\n  }\n}\nreturn tasks;"
            },
            "typeVersion": 2
        },
        {
            "id": "dbcb1ea3-93c7-4a0e-8963-da0687673170",
            "name": "Done",
            "type": "n8n-nodes-base.set",
            "position": [
                720,
                460
            ],
            "parameters": {
                "mode": "manual",
                "assignments": {
                    "assignments": [
                        {
                            "id": "s1",
                            "name": "status",
                            "type": "string",
                            "value": "Scrape complete"
                        },
                        {
                            "id": "s2",
                            "name": "finished_at",
                            "type": "string",
                            "value": "={{ $now.toISO() }}"
                        }
                    ]
                },
                "includeOtherFields": false
            },
            "typeVersion": 3.4
        },
        {
            "id": "e3979474-a4df-4378-9cc2-b2789d435ee2",
            "name": "Apollo People Search",
            "type": "n8n-nodes-base.httpRequest",
            "position": [
                720,
                200
            ],
            "parameters": {
                "url": "https://api.apollo.io/api/v1/mixed_people/search",
                "method": "POST",
                "jsonBody": "={\n  \"person_titles\": [\"owner\",\"founder\",\"co-founder\",\"ceo\",\"president\",\"general manager\",\"managing director\",\"director of operations\",\"director of sales\",\"commercial director\",\"director of revenue\",\"revenue manager\",\"marketing director\",\"propietario\",\"gerente general\",\"director general\"],\n  \"person_locations\": [\"{{ $json.location }}\"],\n  \"organization_num_employees_ranges\": [\"1,10\",\"11,50\",\"51,200\"],\n  \"page\": {{ $json.page }},\n  \"per_page\": 100\n}",
                "sendBody": true,
                "sendHeaders": true,
                "specifyBody": "json",
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        },
                        {
                            "name": "X-Api-Key",
                            "value": "<__PLACEHOLDER_VALUE__Paste your Apollo API key__>"
                        }
                    ]
                }
            },
            "retryOnFail": true,
            "typeVersion": 4.2
        },
        {
            "id": "c6896974-8601-4355-bef5-d64619a90e00",
            "name": "Throttle",
            "type": "n8n-nodes-base.wait",
            "position": [
                940,
                200
            ],
            "webhookId": "be7835b2-1638-408e-937e-9f282f245bd1",
            "parameters": {
                "unit": "seconds",
                "amount": 1
            },
            "typeVersion": 1.1
        },
        {
            "id": "bcebece3-7df9-41ac-bd6f-3569c5b79542",
            "name": "Split People",
            "type": "n8n-nodes-base.splitOut",
            "position": [
                1160,
                200
            ],
            "parameters": {
                "include": "noOtherFields",
                "fieldToSplitOut": "people"
            },
            "typeVersion": 1
        },
        {
            "id": "4bc8e2f5-9abd-4e6d-8a56-0a2324ed8bb5",
            "name": "Apollo Reveal Contact",
            "type": "n8n-nodes-base.httpRequest",
            "position": [
                1380,
                200
            ],
            "parameters": {
                "url": "https://api.apollo.io/api/v1/people/match",
                "method": "POST",
                "jsonBody": "={ \"id\": \"{{ $json.id }}\", \"reveal_personal_emails\": true }",
                "sendBody": true,
                "sendHeaders": true,
                "specifyBody": "json",
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        },
                        {
                            "name": "X-Api-Key",
                            "value": "<__PLACEHOLDER_VALUE__Paste your Apollo API key (same key)__>"
                        }
                    ]
                }
            },
            "retryOnFail": true,
            "typeVersion": 4.2
        },
        {
            "id": "cd36986d-baf8-4aae-b27a-85e609404f0d",
            "name": "Lead Row",
            "type": "n8n-nodes-base.set",
            "position": [
                1600,
                200
            ],
            "parameters": {
                "mode": "manual",
                "assignments": {
                    "assignments": [
                        {
                            "id": "a1",
                            "name": "hotel_name",
